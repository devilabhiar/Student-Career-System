<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

    <!-- ✅ Student Signup Servlet -->
    <servlet>
        <servlet-name>SignupServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.SignupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SignupServlet</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <!-- ✅ Student Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- ✅ Add Skill Servlet -->
    <servlet>
        <servlet-name>AddSkillServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.AddSkillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddSkillServlet</servlet-name>
        <url-pattern>/addSkill</url-pattern>
    </servlet-mapping>

    <!-- ✅ Admin Login Servlet -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/AdminLoginServlet</url-pattern>
    </servlet-mapping>

    <!-- ✅ View All Students Servlet -->
    <servlet>
        <servlet-name>ViewStudentsServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.ViewStudentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewStudentsServlet</servlet-name>
        <url-pattern>/viewStudents</url-pattern>
    </servlet-mapping>

    <!-- ✅ Delete Student Servlet -->
    <servlet>
        <servlet-name>DeleteStudentServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.DeleteStudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteStudentServlet</servlet-name>
        <url-pattern>/deleteStudent</url-pattern>
    </servlet-mapping>

    <!-- ✅ Admin Logout Servlet -->
    <servlet>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.AdminLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <url-pattern>/adminLogout</url-pattern>
    </servlet-mapping>

    <!-- ✅ Student Logout Servlet -->
    <servlet>
        <servlet-name>StudentLogoutServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.StudentLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentLogoutServlet</servlet-name>
        <url-pattern>/studentLogout</url-pattern>
    </servlet-mapping>

    <!-- ✅ View Student Skills Servlet -->
    <servlet>
        <servlet-name>ViewStudentSkillsServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.ViewStudentSkillsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewStudentSkillsServlet</servlet-name>
        <url-pattern>/admin/view-student-skills</url-pattern>
    </servlet-mapping>

    <!-- ✅ Forgot / Reset Password -->
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <!-- ✅ Show Career Suggestions Servlet -->
    <servlet>
        <servlet-name>ShowCareerSuggestionsServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.ShowCareerSuggestionsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShowCareerSuggestionsServlet</servlet-name>
        <url-pattern>/ShowCareerSuggestionsServlet</url-pattern>
    </servlet-mapping>

    <!-- ========================= -->
    <!-- Added: GenerateResumeServlet -->
    <!-- ========================= -->
    <servlet>
        <servlet-name>GenerateResumeServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.GenerateResumeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GenerateResumeServlet</servlet-name>
        <url-pattern>/generateResume</url-pattern>
    </servlet-mapping>

    <!-- Optional: DownloadBookServlet (if you're using download feature) -->
    <servlet>
        <servlet-name>DownloadBookServlet</servlet-name>
        <servlet-class>com.studentcareer.servlet.DownloadBookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadBookServlet</servlet-name>
        <url-pattern>/downloadBook</url-pattern>
    </servlet-mapping>

    <!-- ✅ Welcome file -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
